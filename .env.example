# Kedar Properties Production Environment Variables Template

# Base Production Domain URL
VITE_SITE_URL=https://www.kedarproperties.in

# Central Remote Database Integration (Supabase Option)
# 1. Create a project at https://supabase.com
# 2. Create a 'properties' table with property schema
# 3. Paste your Project URL and Publishable Key below for multi-device sync
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Central REST API Endpoint (Custom Backend Option)
VITE_API_BASE_URL=https://api.kedarproperties.in

# Google Analytics / Tag Manager Measurement ID (Optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
